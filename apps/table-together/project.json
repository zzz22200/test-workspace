{
  "name": "table-together",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/table-together",
  "projectType": "application",
  "tags": [],
  "// targets": "to see all targets run: nx show project table-together --web",
  "targets": {
    "build": {
      "executor": "@nx/next:build",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "apps/table-together/.next"
      },
      "configurations": {
        "development": {
          "outputPath": "apps/table-together/.next"
        },
        "production": {}
      }
    },
    "serve": {
      "executor": "@nx/next:server",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "table-together:build",
        "dev": true
      },
      "configurations": {
        "development": {
          "buildTarget": "table-together:build:development",
          "dev": true
        },
        "production": {
          "buildTarget": "table-together:build:production",
          "dev": false
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"]
    }
  }
}
